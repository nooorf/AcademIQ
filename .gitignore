cat > .gitignore << 'EOF'
# macOS
.DS_Store
**/.DS_Store

# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
*.egg-info/

# Virtual environment
venv/
.venv/
env/

# Environment variables
.env

# Data files (PDFs and processed output — too large for git)
data/raw/
data/processed/
data/synthetic/
*.pdf

# Model indexes (regenerated by make index)
*.pkl
*.json
*.jsonl

# Experiment outputs
experiments/results/

# Jupyter
.ipynb_checkpoints/

# IDE
.vscode/
.idea/
EOF